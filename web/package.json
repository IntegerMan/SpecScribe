{
  "name": "specscribe-web",
  "private": true,
  "type": "module",
  "description": "SpecScribe's Vue/Nuxt 3 presentation layer (Epic 23). Production-intent, but NOT in SpecScribe.slnx and NOT wired into `specscribe generate` — packaging is Story 23.5.",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/sync-runtime-assets.mjs && nuxt dev",
    "build": "node scripts/sync-runtime-assets.mjs && nuxt build",
    "build:package": "node scripts/build-package.mjs",
    "generate": "node scripts/sync-runtime-assets.mjs && nuxt generate",
    "postinstall": "nuxt prepare",
    "extract:tokens": "node scripts/extract-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "extract:ir-content": "node scripts/extract-ir-content.mjs",
    "check:ir-content": "node scripts/check-ir-content.mjs",
    "report:ir-content-residue": "node scripts/report-ir-content-residue.mjs",
    "sync:assets": "node scripts/sync-runtime-assets.mjs",
    "check:assets": "node scripts/sync-runtime-assets.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "measure:payload": "node scripts/measure-payload.mjs",
    "measure:parity": "node scripts/measure-parity.mjs",
    "check": "npm run check:tokens && npm run check:ir-content && npm run check:assets && npm run check:parity",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "node scripts/check-tokens.mjs",
    "pregenerate": "node scripts/check-tokens.mjs",
    "experiment:two-ir": "node scripts/experiment-two-ir.mjs",
    "pin:parity": "node scripts/pin-parity.mjs",
    "check:parity": "node scripts/check-parity.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nuxt": "^4.5.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  }
}
